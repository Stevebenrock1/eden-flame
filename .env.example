# Shopify (headless). When both are set, products, checkout and orders run on Shopify
# and EDEN_API_URL is ignored. See README "Running on Shopify".
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=

# Eden Flame API (eden-flame-api). Leave empty to use the built-in sample catalog and a browser-only bag.
EDEN_API_URL=
